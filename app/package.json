{
  "name": "colorwizard-desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:verbose": "bash scripts/dev-verbose.sh",
    "desktop:dev:monitor": "bash scripts/monitor-build.sh",
    "desktop:build": "tauri build",
    "app:build": "unset CI && tauri build",
    "app:install": "bash scripts/install-app.sh",
    "app:restart": "bash scripts/restart-app.sh",
    "app:kill": "bash scripts/kill-app.sh",
    "app:open": "open \"$(cd .. && pwd)/ColorWizard Desktop.app\"",
    "dev:clean": "bash scripts/kill-app.sh && npm run desktop:dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.4.20"
  }
}
